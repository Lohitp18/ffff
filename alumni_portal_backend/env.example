# Copy to .env (recommended) and/or config.env and fill in values.
# Server loads: config.env.production (prod only) → config.env → .env last with override.
# Values in .env always win over config files and typical shell defaults.

MONGO_URI=mongodb://127.0.0.1:27017/alumni_portal
JWT_SECRET=change-me
# Access token TTL (default 30d)
# JWT_EXPIRES_IN=30d
# Refresh token TTL (default 30d)
# JWT_REFRESH_EXPIRES_IN=30d

# Optional: send SMS on successful login (login alert template)
# SEND_LOGIN_ALERT_SMS=true

DOSNET_API_URL=https://sms.dosnet.in/sms-panel/api/http/index.php
DOSNET_API_KEY=
DOSNET_USERNAME=
DOSNET_PASSWORD=
# Required by DOSNET HTTP API (omit only if your panel docs say otherwise)
# DOSNET_API_REQUEST_PARAM=request
# DOSNET_API_REQUEST=send
# apirequest=Text (SMS type); override name/value if your panel differs
# DOSNET_APIREQUEST_PARAM=apirequest
# DOSNET_APIREQUEST=Text
DOSNET_SENDERID=ALVASF
DOSNET_ROUTE=TRANS
# Fallback DLT template id when a flow-specific id below is not set
DOSNET_TEMPLATE_ID=

# DLT template ids per flow (names match common env spellings; code also accepts *_SUCCESSFUL_*)
# DOSNET_SIGNUP_OTP_SMS_TEMPLATE_ID=1107177553565973773
# DOSNET_RESET_OTP_SMS_TEMPLATE_ID=1107177553572150757
# DOSNET_APPROVED_SMS_TEMPLATE_ID=1107177553579353727
# DOSNET_RESET_SUCESSFULL_SMS_TEMPLATE_ID=1107177532405577935
# DOSNET_SIGNUP_SUCESSFULL_SMS_TEMPLATE_ID=1107177532421359045

# Optional: separate DLT template for “account approved” SMS (alias of DOSNET_APPROVED_SMS_TEMPLATE_ID)
# DOSNET_APPROVAL_TEMPLATE_ID=
# DOSNET_APPROVAL_MESSAGE=Dear {name}, your Alvas Connect alumni account has been approved. You can sign in now.

# Optional: signup success SMS body (must match your DLT template if using template id above)
# DOSNET_SIGNUP_SUCCESS_SMS_MESSAGE=

# Portal URL inserted into approved templates when using messageTemplates defaults
# ALVAS_PORTAL_URL=https://alvas.org/

# Optional: login alert SMS template
# DOSNET_LOGIN_ALERT_TEMPLATE_ID=
# DOSNET_LOGIN_ALERT_MESSAGE=

# Azure Blob Storage — NEVER commit keys; use connection string only on the server.
# Storage account (example): alvasalumni
# Containers created/used by the app: profile-images, cover-images, posts, videos, institution-posts
AZURE_STORAGE_CONNECTION_STRING=
# Optional: for client-side direct upload SAS (do not expose in frontend build)
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=

# Local dev only — returns OTP in API JSON (never enable in production)
# EXPOSE_DEV_OTP=true

# Dev-only: log exact SMS message text (includes OTP). Do NOT enable in production logs.
# LOG_SMS_EXACT_MESSAGE=true

# OTP rate limits (per IP, 15 min window)
# OTP_STRICT_RATE_LIMIT_MAX=12
# OTP_RATE_LIMIT_MAX=30

# WhatsApp (Meta / BSP) — optional; used with SMS for OTP and notifications
# DOSNET_WA_API_URL=https://graph.facebook.com/v18.0
# DOSNET_WA_TOKEN=
# DOSNET_WA_PHONE_NUMBER_ID=
# Template names (approved in WhatsApp Manager). When set, sends type=template instead of plain text.
# OTP templates usually need one body variable {{1}} = code.
# DOSNET_WA_SIGNUP_OTP_TEMPLATE_NAME=
# DOSNET_WA_RESET_OTP_TEMPLATE_NAME=
# DOSNET_WA_APPROVED_TEMPLATE_NAME=
# DOSNET_WA_RESET_SUCESSFULL_TEMPLATE_NAME=
# DOSNET_WA_SIGNUP_SUCESSFULL_TEMPLATE_NAME=
# Language for template messages (code sent to API). Use DOSNET_WA_LANGUAGE_CODE=en or en_US when needed.
# DOSNET_WA_LANGUAGE=English
# DOSNET_WA_LANGUAGE_CODE=en

# SMTP — required for email-based password reset OTP
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
